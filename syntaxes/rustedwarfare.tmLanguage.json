                        }
                    }
                },
                {
                    "match": "^\\s*(\\[)(effect)(_)([^\\]]+)(\\])",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.section.begin.rustedwarfare"
                        },
                        "2": {
                            "name": "keyword.control.section.effect.rustedwarfare"
                        },
