                            "name": "punctuation.definition.section.begin.rustedwarfare"
                        },
                        "2": {
                            "name": "keyword.control.section.attack.rustedwarfare"
                        },
                        "3": {
                            "name": "punctuation.definition.section.end.rustedwarfare"
