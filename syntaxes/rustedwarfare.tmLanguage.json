        "directive": {
            "match": "^\\s*(@[A-Za-z]+)\\s*(:)?",
            "captures": {
                "1": {
                    "name": "keyword.control.directive.rustedwarfare"
                },
                "2": {
                    "name": "punctuation.separator.key-value.rustedwarfare"
                }
            }
        },
        "key": {
            "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
            "captures": {
                "1": {
                    "name": "variable.other.key.rustedwarfare"
                },
                "2": {
                    "name": "punctuation.separator.key-value.rustedwarfare"
                }
            }
        },
        "value": {
            "comment": "всё, что может встретиться ПОСЛЕ двоеточия в значении поля",
            "patterns": [
                {
                    "include": "#typeName"
                },
                {
                    "include": "#interpolation"
                },
                {
                    "include": "#colorHex"
                },
                {
                    "include": "#filepath"
                },
                {
                    "include": "#logicKeywords"
                },
                {
                    "include": "#function-call"
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#booleans"
                },
                {
                    "include": "#time"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#operators"
                }
            ]
        },
        "interpolation": {
            "match": "\\$\\{[^}]*\\}",
            "name": "variable.other.interpolation.rustedwarfare"
        },
        "colorHex": {
            "match": "#[0-9a-fA-F]{6}\\b",
            "name": "constant.other.color.rustedwarfare"
        },
        "filepath": {
            "match": "\\b(ROOT:)?[^\\s,:]+\\.(ini|txt|template|png|jpg|jpeg|ogg|wav|mp3)\\b",
            "name": "string.other.filepath.rustedwarfare"
        },
        "logicKeywords": {
            "patterns": [
                {
                    "match": "\\bself\\b",
                    "name": "variable.language.self.rustedwarfare"
                },
                {
                    "match": "\\b(memory|resource)(\\.[A-Za-z0-9_]+)?\\b",
                    "name": "variable.other.property.rustedwarfare"
                },
                {
                    "match": "\\b(and|or|not|if)\\b",
                    "name": "keyword.operator.logical.rustedwarfare"
                }
            ]
        },
        "function-call": {
            "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
            "name": "entity.name.function.rustedwarfare"
        },
        "strings": {
            "patterns": [
                {
                    "match": "'[^']*'",
                    "name": "string.quoted.single.rustedwarfare"
                },
                {
                    "match": "\"[^\"]*\"",
                    "name": "string.quoted.double.rustedwarfare"
                }
            ]
        },
        "booleans": {
            "match": "\\b(true|false)\\b",
            "name": "constant.language.boolean.rustedwarfare"
        },
        "time": {
            "match": "\\b\\d+(\\.\\d+)?(s|ms)\\b",
            "name": "constant.numeric.time.rustedwarfare"
        },
        "numbers": {
            "match": "\\b-?\\d+(\\.\\d+)?\\b",
            "name": "constant.numeric.rustedwarfare"
        },
        "operators": {
            "match": "(<=|>=|==|!=|\\+=|-=|<|>|=|\\+|-|/|\\*|%)",
            "name": "keyword.operator.rustedwarfare"
        },
        "typeName": {
            "comment": "Имя типа (LocaleString, bool, float...) — только если это ПОСЛЕДНЕЕ слово в значении, иначе словил бы обычные слова типа 'over time' в описаниях",
            "match": "\\b(customResource|movementTypes|LocaleString|LogicBoolean|TeamRelation|logicBoolean|logicNumber|customPrice|unitTypes|resources|resource|relation|unitref|boolean|effects|dynamic|degrees|actions|string|images|effect|turret|marker|colour|memory|fields|float|point|event|image|price|color|bool|ints|enum|unit|time|list|tags|int)\\s*$",
            "name": "support.type.rustedwarfare"
        }
    }
}