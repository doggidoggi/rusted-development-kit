{
    "name": "Rusted Warfare INI",
    "scopeName": "source.rustedwarfare",
    "patterns": [
        {
            "include": "#multilineComment"
        },
        {
            "include": "#commentSection"
        },
        {
            "include": "#multistring"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#section"
        },
        {
            "include": "#memoryDefinition"
        },
        {
            "include": "#directive"
        },
        {
            "include": "#key"
        },
        {
            "include": "#value"
        }
    ],
    "repository": {
        "multilineComment": {
            "comment": "\"\"\" в НАЧАЛЕ строки (кроме пробелов) — это блок-комментарий",
            "begin": "^\\s*\"\"\"",
            "end": "\"\"\"",
            "name": "comment.block.rustedwarfare"
        },
        "commentSection": {
            "comment": "секция [comment_XXX] — всё до следующей секции считается комментарием",
            "begin": "^\\s*\\[comment_[^\\]]*\\]",
            "end": "(?=^\\s*\\[[^\\]]*\\])",
            "name": "comment.block.section.rustedwarfare",
            "patterns": [
                {
                    "match": ".*",
                    "name": "comment.block.rustedwarfare"
                }
            ]
        },
        "multistring": {
            "comment": "\"\"\" НЕ в начале строки — это многострочная строка-значение, а не комментарий",
            "begin": "\"\"\"",
            "end": "\"\"\"",
            "name": "string.quoted.triple.rustedwarfare"
        },
        "memoryDefinition": {
            "comment": "@memory name: type — каждый тип получает свой scope",
            "patterns": [
                {
                    "match": "^\\s*(@memory)\\s+([A-Za-z0-9_]+)\\s*(:)\\s*(unit)(\\[\\])?",
                    "captures": {
                        "1": {
                            "name": "keyword.control.directive.rustedwarfare"
                        },
                        "2": {
                            "name": "variable.other.memory.name.rustedwarfare"
                        },
                        "3": {
                            "name": "punctuation.separator.key-value.rustedwarfare"
                        },
                        "4": {
                            "name": "storage.type.unit.rustedwarfare"
                        },
                        "5": {
                            "name": "storage.modifier.array.rustedwarfare"
                        }
                    }
                },
                {
                    "match": "^\\s*(@memory)\\s+([A-Za-z0-9_]+)\\s*(:)\\s*(float)(\\[\\])?",
                    "captures": {
                        "1": {
                            "name": "keyword.control.directive.rustedwarfare"
                        },
                        "2": {
                            "name": "variable.other.memory.name.rustedwarfare"
                        },
                        "3": {
                            "name": "punctuation.separator.key-value.rustedwarfare"
                        },
                        "4": {
                            "name": "storage.type.float.rustedwarfare"
                        },
                        "5": {
                            "name": "storage.modifier.array.rustedwarfare"
                        }
                    }
                },
                {
                    "match": "^\\s*(@memory)\\s+([A-Za-z0-9_]+)\\s*(:)\\s*(number)(\\[\\])?",
                    "captures": {
                        "1": {
                            "name": "keyword.control.directive.rustedwarfare"
                        },
                        "2": {
                            "name": "variable.other.memory.name.rustedwarfare"
                        },
                        "3": {
                            "name": "punctuation.separator.key-value.rustedwarfare"
                        },
                        "4": {
                            "name": "storage.type.number.rustedwarfare"
                        },
                        "5": {
                            "name": "storage.modifier.array.rustedwarfare"
                        }
                    }
                },
                {
                    "match": "^\\s*(@memory)\\s+([A-Za-z0-9_]+)\\s*(:)\\s*(boolean|bool)(\\[\\])?",
                    "captures": {
                        "1": {
                            "name": "keyword.control.directive.rustedwarfare"
                        },
                        "2": {
                            "name": "variable.other.memory.name.rustedwarfare"
                        },
                        "3": {
                            "name": "punctuation.separator.key-value.rustedwarfare"
                        },
                        "4": {
                            "name": "storage.type.boolean.rustedwarfare"
                        },
                        "5": {
                            "name": "storage.modifier.array.rustedwarfare"
                        }
                    }
                },
                {
                    "match": "^\\s*(@memory)\\s+([A-Za-z0-9_]+)\\s*(:)\\s*(string)(\\[\\])?",
                    "captures": {
                        "1": {
                            "name": "keyword.control.directive.rustedwarfare"
                        },
                        "2": {
                            "name": "variable.other.memory.name.rustedwarfare"
                        },
                        "3": {
                            "name": "punctuation.separator.key-value.rustedwarfare"
                        },
                        "4": {
                            "name": "storage.type.string.rustedwarfare"
                        },
                        "5": {
                            "name": "storage.modifier.array.rustedwarfare"
                        }
                    }
                }
            ]
        },
        "comments": {
            "match": "#.*$",
            "name": "comment.line.number-sign.rustedwarfare"
        },
        "section": {
            "patterns": [
                {
                    "match": "^\\s*(\\[)(ai)(\\])",
